install.packages("ape")
library(ape)
# load tree with support values
tree <- read.tree("metazoa_raxml.raxml.supportFBP")
# root tree using outgroup
rooted_tree <- root(tree,
outgroup = c("Plakina_jani", "Grantia_compressa"),
resolve.root = TRUE)
# save rooted tree
write.tree(rooted_tree, file = "metazoa_raxml_rooted.treefile")
# plot and export tree
pdf("metazoa_raxml_rooted_tree.pdf", width = 12, height = 10)
plot(rooted_tree, cex = 0.7)
nodelabels()
dev.off()
# load the aligned DNA sequences
dna <- read.dna("metazoa_alignment.gene.fasta", format = "fasta")
# get sequence names
labs <- rownames(dna)
# find the Homo sapiens sequence
hs_idx <- grep("Homo_sapiens", labs)
hs_name <- labs[hs_idx[1]]
hs_dna <- dna[hs_idx[1], ]
# convert the sequence to characters and remove gaps / missing data
hs_chars <- as.character(hs_dna)
hs_chars_nogap <- hs_chars[!hs_chars %in% c("-", "n", "N", "?")]
# join the nucleotide sequence together
hs_seq <- paste(hs_chars_nogap, collapse = "")
# trim the sequence so its length is divisible by 3
trim_len <- nchar(hs_seq) - (nchar(hs_seq) %% 3)
hs_seq_trim <- substr(hs_seq, 1, trim_len)
# translate nucleotide sequence into protein
protein <- translate(DNAbin(strsplit(hs_seq_trim, "")[[1]]), genetic.code = 1)
